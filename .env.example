# Copy to server/.env or export before npm start

PORT=3000

# Public IP or hostname clients use for ICE (required on cloud / NAT)
ANNOUNCED_IP=

# Optional STUN/TURN for the browser (JSON array of RTCIceServer)
# STUN is optional with mediasoup ICE-Lite; TURN helps behind symmetric NAT.
# Example:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
# ICE_SERVERS=

# Optional overrides
# MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_MIN_PORT=40000
# MEDIASOUP_MAX_PORT=49999
# MAX_PEERS=12
